[Unit]
Description=AlfaCyberCup Web Dashboard
After=network.target

[Service]
Type=simple
User=alfacybercup
Group=alfacybercup
WorkingDirectory=/opt/alfacybercup
EnvironmentFile=/opt/alfacybercup/.env
ExecStart=/opt/alfacybercup/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alfacybercup/data

[Install]
WantedBy=multi-user.target
