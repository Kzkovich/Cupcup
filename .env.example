# Скопируй в .env и заполни
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=sqlite:///./data/app.db

# Почты через запятую — эти аккаунты получают права администратора
ADMIN_EMAILS=admin@example.com

# Инвайт-код на регистрацию. Пусто = регистрация открыта всем
INVITE_CODE=

# Telegram-бот для опциональных уведомлений. Пусто = раздел уведомлений скрыт
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# Контакты организаторов, показываются на экране "Не могу войти"
ORG_CONTACT_TEXT=Напишите организаторам в Telegram: @example

# true в проде за HTTPS, false при локальной разработке по http
SESSION_COOKIE_SECURE=false

ENV=dev
